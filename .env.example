APP_NAME=Jlune
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email SMTP: configurabile da Admin → Canali di invio (consigliato).
# I valori .env sotto servono solo come fallback locale se il DB non è pronto.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fuso orario (obbligatorio su Plesk per date arrivo/partenza corrette)
APP_TIMEZONE=Europe/Rome

# Checkfront (solo server-side — non committare valori reali)
CHECKFRONT_HOST=jlune.checkfront.com
CHECKFRONT_TIMEZONE=Europe/Rome
CHECKFRONT_API_KEY=
CHECKFRONT_API_SECRET=
CHECKFRONT_PAYMENT_URL=https://jlune.checkfront.com/reserve/

# Log webhook import (opzionale: se omesso, usa il primo file che trova)
# Locale:  app/checkfront_data/laravel.log
# Plesk:   storage/logs/laravel.log
# CHECKFRONT_WEBHOOK_LOG_PATH=app/checkfront_data/laravel.log

# Google Document AI (estrazione dati da CI / CF)
# 1) Scarica JSON service account da Google Cloud Console
# 2) Salvalo come storage/app/google-credentials.json (NON committare su Git)
# 3) Locale: percorso relativo OK. Plesk: usa percorso ASSOLUTO.
GOOGLE_APPLICATION_CREDENTIALS=storage/app/google-credentials.json
GOOGLE_CLOUD_PROJECT_ID=
# Deve coincidere con la regione del processor in Google Cloud (es. us o eu)
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# Google AI Studio / Gemini (estrazione alternativa, prossimo step)
GEMINI_API_KEY=

# Area /admin/sviluppo (solo team). Su Plesk impostare una password forte.
JLUNE_DEV_PASSWORD=

# Prenotazioni TEST manuali in /admin/sviluppo (default: solo APP_ENV=local)
# JLUNE_TEST_BOOKINGS_ENABLED=true

# WhatsApp: Admin → Canali di invio (Twilio consigliato, oppure CallMeBot / log).
# Fallback .env:
# JLUNE_WHATSAPP_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Notifiche team — Telegram consigliato per il «trillo» sul telefono
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=jlune_notifiche_bot
# Segreto nell'URL webhook: /webhook/telegram/IL_TUO_SEGRETO
TELEGRAM_WEBHOOK_SECRET=
# Chat ID separati da virgola (es. 123456789,987654321) — admin/team
TELEGRAM_NOTIFY_CHAT_IDS=

# Web Push (PWA installata). Genera chiavi: php artisan jlune:vapid-keys
WEBPUSH_ENABLED=false
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:admin@jlune.local
