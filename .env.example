APP_NAME=Jlune
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fuso orario (obbligatorio su Plesk per date arrivo/partenza corrette)
APP_TIMEZONE=Europe/Rome

# Checkfront (solo server-side — non committare valori reali)
CHECKFRONT_HOST=jlune.checkfront.com
CHECKFRONT_TIMEZONE=Europe/Rome
CHECKFRONT_API_KEY=
CHECKFRONT_API_SECRET=
CHECKFRONT_PAYMENT_URL=https://jlune.checkfront.com/reserve/

# Log webhook import (opzionale: se omesso, usa il primo file che trova)
# Locale:  app/checkfront_data/laravel.log
# Plesk:   storage/logs/laravel.log
# CHECKFRONT_WEBHOOK_LOG_PATH=app/checkfront_data/laravel.log

# Google Document AI (estrazione dati da CI / CF)
# Serve il file JSON del service account sul server, NON solo queste variabili:
GOOGLE_APPLICATION_CREDENTIALS=/percorso/assoluto/google-service-account.json
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=eu
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# Google AI Studio / Gemini (estrazione alternativa, prossimo step)
GEMINI_API_KEY=
